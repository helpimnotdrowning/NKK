@page "/museum/{TitleId}"
@inject PostStore PostStore

<AppTitle>@ArtifactData.Title</AppTitle>
<UsePrism />

<Markdown Content="@ArtifactData.GetMarkdown()" hx-disable></Markdown>

@code {
	[Parameter]
	public required String TitleId { get; set; }

	public required ArtifactPayload ArtifactData;
	
	protected override Task OnInitializedAsync() {
		ArtifactData = PostStore.GetArtifact(TitleId);
		
		return base.OnInitializedAsync();
	}
}