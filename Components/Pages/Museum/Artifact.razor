@page "/museum/{FullId}"
@inject PostStore PostStore
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager

<AppTitle>@ArtifactData.Title</AppTitle>
<UsePrism />

<Markdown Content="@ArtifactData.GetMarkdown()" hx-disable></Markdown>

@code {
	[Parameter]
	public required String FullId { get; set; }

	public required ArtifactPayload? ArtifactData;
	
	protected override Task OnInitializedAsync() {
		ArtifactData = PostStore.Get<ArtifactPayload>(FullId);
		
		if (ArtifactData == null) {
			HttpContextAccessor.HttpContext!.Response.StatusCode = StatusCodes.Status404NotFound;
			NavigationManager.NotFound();
		}
		
		return base.OnInitializedAsync();
	}
}