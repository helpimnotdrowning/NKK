@page "/museum"
@inject PostStore PostStore

<div class="flex flex-col gap-2">
	@foreach (var p in Posts) {
		<div class="post-component" id="artifact-@p.Id.FullId">
			<h2 class="post-title">
				<a href="/museum/@p.Id.FullId">@p.Title</a>
			</h2>
			<p class="flex gap-2">
				<span class="text-current/50">@p.Created.ToString("yyyy-MM-dd")</span>
				@p.Title
			</p>
		</div>
	}
</div>

@code {
	public required IEnumerable<ArtifactPayload> Posts;
	
	protected override Task OnInitializedAsync() {
		Posts = PostStore.GetAllArtifacts();
		
		return base.OnInitializedAsync();
	}
}