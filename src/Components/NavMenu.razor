<div id="nav-sticky-check" class="h-0 w-full"/>
<nav class="n-box mt-2! w-full sticky top-4 z-99" on-init="@_nav__on_init" hx-preserve="true">
	<div>
		@* maybe make this a list... *@
		<div class="float-left flex gap-4">
			<a hx-boost="true" href="/">Home</a>
			<a hx-boost="true" href="/sayings">Posts</a>
			<a hx-boost="true" href="/museum">Museum</a>
		</div>
		<div class="float-right">
			<a
				class="text-blue-600 underline"
				href="https://git.helpimnotdrowning.net/helpimnotdrowning/NKK"
				target="_blank"
			>
				running helpimnotdrowning/NKK
			</a>
		</div>
	</div>
</nav>

@code {

	private readonly String _nav__on_init = @"
	var check = $('#nav-sticky-check');
	var nav = $(this)

	const ob = new IntersectionObserver(entries => entries.forEach(entry =>
		nav.toggleClass('but-wider', !entry.isIntersecting)
	), { threshold: [0] });

	ob.observe( check[0] );
";

}