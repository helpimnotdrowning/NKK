@page "/Error"
@layout MainLayoutNoNBox
@using Microsoft.AspNetCore.Diagnostics
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment Env

<AppTitle>OOPSIE WOOPSIE!!</AppTitle>

<div class="tx n-box text-center gap-2">
	<h1>
		<span class="text-6xl">@HttpContextAccessor.HttpContext!.Response.StatusCode</span>
		<br/>
		<span class="text-4xl">
			@Microsoft.AspNetCore.WebUtilities.ReasonPhrases.GetReasonPhrase(
				HttpContextAccessor.HttpContext.Response.StatusCode
			)
		</span>
	</h1>
	OOPSIE WOOPSIE!! Uwu We made a fucky wucky!! A wittle fucko boingo! The code monkeys at our headquarters are working VEWY HAWD to fix this!
	<hr thin />
	<a href="/" class="clickable p-4">go home......</a>
</div>
	
@if (Env.IsDevelopment() && ExceptionHandler != null && Ex is not StatusCodeException) {
<div class="tx n-box">
	<h2>@Ex.GetType(): @Ex.Message</h2>
	<pre>@Ex.StackTrace</pre>
	
	@{ var inner = Ex.InnerException; }
	@while ( inner != null ) {
		<h3>(inner) @inner.GetType(): @inner.Message</h3>
		<pre>@inner.StackTrace</pre>
		inner = inner.InnerException;
	}
	
</div>
}

@code {
	private IExceptionHandlerFeature? ExceptionHandler => HttpContextAccessor.HttpContext!.Features.Get<IExceptionHandlerFeature>();
	private Exception Ex => ExceptionHandler!.Error;

	protected override void OnInitialized() {
		var triggered = (bool?)HttpContextAccessor.HttpContext!.Items[ExceptionCatchingMiddleware.Name_ItemTriggered];
		if (triggered != true)
			throw new StatusCodeException(404);
		
		base.OnInitialized();
	}
}