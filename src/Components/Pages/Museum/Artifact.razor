@page "/museum/{FullId}"
@using FluentResults
@layout MainLayoutNoNBox
@inject PostStore PostStore

<AppTitle>@ArtifactData.Title</AppTitle>

<figure class="n-box">
	<Gallery Artifact="@ArtifactData" />
</figure>

<figcaption id="artifact-text" class="n-box">
	<div class="tx">
		<h1>@ArtifactData.Title</h1>
		<span class="post-info-span">
			Published @ArtifactData.Created.ToString("yyyy-MM-dd")
			&mdash;
			Tags: "@( String.Join("\", \"", ArtifactData.Tags) )"
		</span>
	</div>
	<Markdown Content="@ArtifactData.GetMarkdown()" class="no-top-pad" hx-disable/>
</figcaption>

@code {
	[Parameter]
	public required String FullId { get; set; }

	private Result<PostId> IdBundle => PostId.From(FullId);
	private ArtifactPayload ArtifactData => PostStore.Get<ArtifactPayload>(IdBundle.Value)!;
	
	protected override Task OnInitializedAsync() {
		if (IdBundle.IsFailed || ArtifactData == null)
			throw new StatusCodeException(404);

		return base.OnInitializedAsync();
	}
}