<div class="artifact-gallery">
	@{ int i = 0; }
	@foreach (var image in Artifact.Images) {
		<div id="artifact-holder-@i" class="artifact-holder">
			<div class="artifact-cap">
				<a href="@Artifact.Id.FullId/@image.Name" target="_blank" class="a-normal">@image.Name</a>
			</div>
			<div class="artifact-image-rounder">
				<img class="artifact-image" src="@Artifact.Id.FullId/@image.Name"/>
			</div>
		</div>
		i++;
	}
</div>

@code {
	[Parameter]
	public required ArtifactPayload Artifact { get; set; }
}