@page "/museum"
@layout MainLayoutNoNBox
@inject PostStore PostStore

<AppTitle>Museum</AppTitle>

<div class="n-box clear-n-boxx">
	<ul class="artifactindex-holder">
		@foreach (var p in Posts) {
			<li class="artifactindex-component relative">
				<img src="/museum/@p.Id.FullId/@p.Images.First().Name" alt="@String.Join(", ", p.Tags)" />
				@if (p.Images.Count > 1) {
					<div class="artifactindex-overlay">
						<img alt="Mutliple images indicator" src="@Assets["/media/image_stack.svg"]"/>
					</div>
				}
			</li>
		}
	</ul>
</div>

@code {
	public required IEnumerable<ArtifactPayload> Posts;
	
	protected override Task OnInitializedAsync() {
		Posts = PostStore.GetAll<ArtifactPayload>().OrderByDescending(p => p.Id.NumericId);
		
		return base.OnInitializedAsync();
	}
}