<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <RootNamespace>NKK</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="public/**/*">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="src/Tailwind/style.tw.css" />
    </ItemGroup>
    
    <Target Name="UsePublicNotWwwroot" AfterTargets="Publish">
        <RemoveDir Directories="$(PublishDir)/wwwroot" />
    </Target>

    <Target Name="BurnBranding" BeforeTargets="GetAssemblyAttributes">
        <PropertyGroup>
            <!-- initialize with env bc nix -->
            <GitCommit>$(GIT_COMMIT)</GitCommit>
            <GitCommitShort>$(GIT_COMMIT_SHORT)</GitCommitShort>
        </PropertyGroup>

        <Exec Condition=" '$(GitCommit)' == '' "
              Command="git rev-parse HEAD" ConsoleToMsBuild="true"
              StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
        </Exec>
        <Exec Condition=" '$(GitCommitShort)' == '' "
              Command="git rev-parse --short HEAD" ConsoleToMsBuild="true"
              StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitShort" />
        </Exec>

        <ItemGroup>
            <AssemblyMetadata Include="GitCommitShort" Value="$(GitCommitShort)" />
            <AssemblyMetadata Include="GitCommit" Value="$(GitCommit)" />
            <AssemblyMetadata Include="GitSourceDisplay" Value="tangled.sh/helpimnotdrowning.net/Utatane" />
            <AssemblyMetadata Include="GitSourceUrl" Value="https://tangled.sh/helpimnotdrowning.net/Utatane" />
            <AssemblyMetadata Include="GitSourcePathPreCommit" Value="/tree/" />
        </ItemGroup>
    </Target>
    
    <ItemGroup>
        <PackageReference Include="FluentResults" Version="4.0.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Markdig" Version="1.3.2" />
        <PackageReference Include="NUglify" Version="1.21.17" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageReference Include="ThrottleDebounce" Version="2.0.2" />
        <PackageReference Condition="$(Configuration) != 'Release'"
                Include="Tailwind.Extensions.AspNetCore" Version="1.1.2" />
    </ItemGroup>
    
    <ItemGroup>
        <_ContentIncludedByDefault Remove="Components/" />
        <AdditionalFiles Include="src/Components/" />
    </ItemGroup>

</Project>
